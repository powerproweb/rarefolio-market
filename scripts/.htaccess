# Ops scripts are CLI-only. Block all web access (defense in depth; the PHP files
# also self-guard with a PHP_SAPI !== 'cli' check).
#
# Apache 2.4:
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
# Apache 2.2 fallback:
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
